[Unit]
Description=Telegram bot with exchange
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/excahnge
Environment=PYTHONUNBUFFERED=1
Environment=CHROME_BINARY=/opt/chrome-for-testing/chrome-linux64/chrome
Environment=CHROMEDRIVER_BINARY=/opt/chrome-for-testing/chromedriver-linux64/chromedriver
ExecStart=/root/excahnge/venv/bin/python3 /root/excahnge/all_exchange.py
Restart=on-failure
RestartSec=10
MemoryHigh=400M
MemoryMax=512M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
